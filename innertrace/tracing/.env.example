# OpenAI-Compatible API Configuration for Trace Synthesis
# Copy this file to .env and fill in your API key

# API Key (required for synthesis - use your OpenAI-compatible API key)
# This key is used to authenticate with the synthesis API server
BF_TRACE_SYNTHESIS_API_KEY=sk-your-api-key-here

# Base URL for synthesis API (required)
# Example: http://localhost:5099/v1 or your internal API endpoint
BF_TRACE_SYNTHESIS_BASE_URL=http://localhost:5099/v1

# Optional: Override provider type (default: openai)
# Options: truncation, openai
BF_TRACE_SYNTHESIS_PROVIDER=openai

# Optional: Override model selection
# BF_TRACE_SYNTHESIS_MODEL=your-model-name
